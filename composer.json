{
    "name": "anghelutav/laravel-pdf-templates",
    "description": "PDF templates for Laravel: visual designer (pdfme) or HTML/CSS with placeholders, filled with JSON. Admin UI, test page and a self-hosted API.",
    "keywords": [
        "laravel",
        "pdf",
        "pdf-templates",
        "pdfme",
        "dompdf",
        "designer",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AnghelutaV/laravel-pdf-templates",
    "authors": [
        {
            "name": "AnghelutaV",
            "homepage": "https://github.com/AnghelutaV",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/AnghelutaV/laravel-pdf-templates/issues",
        "source": "https://github.com/AnghelutaV/laravel-pdf-templates",
        "security": "https://github.com/AnghelutaV/laravel-pdf-templates/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "laravel/pint": "^1.32",
        "larastan/larastan": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "AnghelutaV\\PdfTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnghelutaV\\PdfTemplates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnghelutaV\\PdfTemplates\\PdfTemplatesServiceProvider"
            ],
            "aliases": {
                "PdfTemplates": "AnghelutaV\\PdfTemplates\\Facades\\PdfTemplates"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
